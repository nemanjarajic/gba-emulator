#version 450

// Runs the shared self-tests on the GPU, one GBA instance per invocation.
// The host runs the identical source as C++ and compares. See selftest.inc.

#include "core.h"
#include "core.inc"
#include "selftest.inc"

layout(local_size_x = 64) in;

void main() {
    uint inst = gl_GlobalInvocationID.x;
    if (inst >= g_num_instances) return;

    GbaState st;
    selftest_init(st, inst);

    uint result = bus_selftest(st);
    result = result * 33u + cpu_selftest(st, 256u);

    g_fb[MEM_IDX(FB_WORDS, inst, 0u)] = result;
}
