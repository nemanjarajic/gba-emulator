#version 450

// Runs the shared bus self-test on the GPU, one instance per invocation.
// The host runs the identical source as C++ and compares. See selftest.inc.

#include "core.h"
#include "selftest.inc"

layout(local_size_x = 64) in;

void main() {
    uint inst = gl_GlobalInvocationID.x;
    if (inst >= g_num_instances) return;

    GbaState st;
    selftest_init(st, inst);

    g_fb[MEM_IDX(FB_WORDS, inst, 0u)] = bus_selftest(st);
}
