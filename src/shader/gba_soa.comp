#version 450
// The same core as gba.comp, built with the interleaved memory layout so the
// two can be measured against each other without rebuilding.
#define GBA_SOA 1
#include "core.h"
#include "core.inc"

layout(local_size_x = 64) in;

void main() {
    uint inst = gl_GlobalInvocationID.x;
    if (inst >= g_num_instances) return;
    GbaState st = g_state[inst];
    st.inst = inst;
    step_cycles(st, g_cycles);
    g_state[inst] = st;
}
